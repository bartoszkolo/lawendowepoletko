---
// Zwarty hero podstron — zdjęcie pola z gradientem, nadtytuł, tytuł (slot) i lead
interface Props {
  eyebrow: string;
  lead?: string;
}
const { eyebrow, lead } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-lav-800 text-white">
  <div class="absolute inset-0 -z-10">
    <img
      src="/pole.jpg"
      alt=""
      class="h-full w-full object-cover object-[center_38%] opacity-90"
      loading="eager"
      fetchpriority="high"
      width="1920"
      height="1280"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-lav-900/80 via-lav-800/55 to-lav-900/85"></div>
  </div>
  <div class="wrap pb-16 pt-36 sm:pb-20 sm:pt-44">
    <p class="kicker text-lav-200" data-reveal>{eyebrow}</p>
    <h1 class="mt-4 max-w-3xl font-display text-4xl leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl" data-reveal data-reveal-delay="1">
      <slot />
    </h1>
    {lead && (
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-lav-100/95 sm:text-lg" data-reveal data-reveal-delay="2">
        {lead}
      </p>
    )}
  </div>
</section>
