---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import FieldArt from "../components/FieldArt.astro";
import LeadForm from "../components/LeadForm.astro";

const ideas = [
  {
    no: "01",
    title: "Sezonowe smaki",
    text: "Kawa, domowe wypieki i lawendowe akcenty podawane z wyczuciem — menu dopracujemy przed otwarciem.",
  },
  {
    no: "02",
    title: "Miejsce na chwilę",
    text: "Spokojny przystanek podczas wizyty na polu, wycieczki na Lednicę albo rodzinnego dnia w okolicy Gniezna.",
  },
  {
    no: "03",
    title: "Warsztaty i spotkania",
    text: "Przestrzeń, w której z czasem będą mogły odbywać się warsztaty, degustacje i małe wydarzenia blisko natury.",
  },
];
---

<Base
  title="Kawiarnia lawendowa 2027 pod Gnieznem | Lawendowe Poletko"
  description="Poznaj plany kawiarni na Lawendowym Poletku w Skrzetuszewie. Sezonowe smaki, warsztaty i spokojne miejsce 2 km od Pól Lednickich — otwarcie planowane w 2027 roku."
  path="/kawiarnia"
>
  <PageHero eyebrow="Nowy rozdział · 2027" lead="Tworzymy miejsce, w którym wizyta na polu nie będzie kończyła się po ostatnim fioletowym rzędzie.">
    Kawiarnia blisko natury. <em class="text-lav-200">W rytmie Poletka.</em>
  </PageHero>

  <section class="wrap py-20 sm:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="kicker text-lav-500" data-reveal>Dlaczego ją tworzymy</p>
        <h2 class="mt-4 font-display text-3xl leading-tight sm:text-4xl lg:text-5xl" data-reveal>
          Żeby można było zostać <em class="text-lav-500">trochę dłużej.</em>
        </h2>
        <p class="mt-6 leading-relaxed text-inksoft" data-reveal>
          Lawendowe Poletko od 2016 roku rośnie razem z nami i z naszymi gośćmi. Kawiarnia jest naturalnym kolejnym
          krokiem: miejscem odpoczynku, rozmowy i sezonowych smaków po spacerze między lawendą.
        </p>
        <p class="mt-4 leading-relaxed text-inksoft" data-reveal>
          Projekt jest w przygotowaniu. Konkretne menu, godziny i data otwarcia pojawią się dopiero po ich
          potwierdzeniu — na tej stronie będziemy publikować najważniejsze aktualizacje.
        </p>
      </div>
      <div class="overflow-hidden rounded-[2rem] shadow-soft" data-reveal data-reveal-delay="1">
        <FieldArt variant="noon" class="h-80 w-full sm:h-[28rem]" />
      </div>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-3">
      {ideas.map((idea, i) => (
        <article class="card p-7" data-reveal data-reveal-delay={String(i + 1)}>
          <span class="font-display text-4xl italic text-lav-300">{idea.no}</span>
          <h2 class="mt-4 font-display text-2xl">{idea.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-inksoft">{idea.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-lav-900 py-20 text-white sm:py-28">
    <div class="wrap grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-16">
      <div>
        <p class="kicker text-lav-300" data-reveal>Bądź blisko od początku</p>
        <h2 class="mt-4 font-display text-3xl leading-tight sm:text-4xl" data-reveal>
          Powiemy Ci, kiedy <em class="text-lav-300">otworzymy drzwi.</em>
        </h2>
        <p class="mt-5 leading-relaxed text-lav-100/90" data-reveal>
          Zapisz się, jeśli interesuje Cię otwarcie, warsztaty, wydarzenia lub rodzinna oferta kawiarni.
        </p>
      </div>
      <div class="rounded-[1.5rem] bg-paper p-6 text-ink shadow-soft sm:p-8" data-reveal data-reveal-delay="1">
        <LeadForm mode="cafe" />
      </div>
    </div>
  </section>
</Base>
