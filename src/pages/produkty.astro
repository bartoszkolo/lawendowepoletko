---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { SITE } from "../data/site";
import { PRODUCTS } from "../data/products";
import { Image } from "astro:assets";
---

<Base
  title="Produkty lawendowe prosto z pola | Lawendowe Poletko"
  description="Poznaj demonstracyjną kolekcję produktów Lawendowego Poletka: olejek, hydrolat, mydło, świecę i dyfuzor lawendowy. Sklep internetowy w przygotowaniu."
  path="/produkty"
>
  <PageHero eyebrow="Zabierz lawendę do domu" lead="Projektujemy pierwszą kolekcję produktów i sprawdzamy, czego najbardziej potrzebują nasi goście. Poniższe produkty, zdjęcia i ceny są wersją demonstracyjną.">
    Małe rytuały. <em class="text-lav-200">Dużo lawendy.</em>
  </PageHero>

  <section class="wrap py-20 sm:py-28">
    <div class="mb-10 flex flex-col gap-4 rounded-2xl border border-honey/30 bg-honey-soft/20 p-5 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <div>
        <strong class="font-display text-xl">Kolekcja demonstracyjna</strong>
        <p class="mt-1 text-sm leading-relaxed text-inksoft">Produkty nie są jeszcze dostępne do zakupu. Nazwy, pojemności i ceny służą do testowania przyszłego sklepu.</p>
      </div>
      <span class="chip shrink-0 self-start bg-white text-honey sm:self-auto">Projekt oferty</span>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        PRODUCTS.map((product, i) => (
          <article class="card group overflow-hidden" data-reveal data-reveal-delay={String((i % 2) + 1)}>
            <div class="relative aspect-square overflow-hidden bg-cream">
              <Image
                src={product.image}
                alt={product.imageAlt}
                widths={[360, 560, 760]}
                sizes="(min-width: 1024px) 350px, (min-width: 640px) 45vw, 90vw"
                format="webp"
                loading={i < 3 ? "eager" : "lazy"}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
              />
              <span class="absolute left-5 top-5 grid h-11 w-11 place-items-center rounded-full bg-white/90 font-display text-lg text-lav-700 shadow-sm backdrop-blur-sm">
                {String(i + 1).padStart(2, "0")}
              </span>
            </div>
            <div class="flex min-h-64 flex-col p-7">
              <div class="flex items-start justify-between gap-4">
                <small class="text-xs font-bold uppercase tracking-[0.16em] text-honey">{product.size}</small>
                <strong class="font-display text-xl text-lav-700">{product.price}</strong>
              </div>
              <h2 class="mt-2 font-display text-2xl">{product.name}</h2>
              <p class="mt-2.5 text-sm leading-relaxed text-inksoft">{product.description}</p>
              <div class="mt-auto pt-6">
                {product.stripePaymentUrl ? (
                  <a href={product.stripePaymentUrl} target="_blank" rel="noopener noreferrer" class="btn btn-lav w-full">
                    Kup przez Stripe <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="btn w-full cursor-not-allowed bg-lav-100 text-lav-500" aria-disabled="true">Płatności wkrótce</span>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-lav-900 py-20 text-white sm:py-24">
    <div class="wrap grid items-center gap-8 lg:grid-cols-2">
      <div>
        <p class="kicker text-lav-300">Następny rozdział</p>
        <h2 class="mt-4 font-display text-3xl leading-tight sm:text-4xl lg:text-5xl">
          Sklep internetowy <em class="text-lav-300">rośnie razem z nami.</em>
        </h2>
        <p class="mt-5 max-w-xl leading-relaxed text-lav-100/90">
          Zostajemy przy prostym rozwiązaniu: każda karta otrzyma własny bezpieczny link płatności Stripe. Bez
          abonamentu za platformę sklepową i bez zmiany charakteru tej strony.
        </p>
      </div>
      <div class="flex flex-wrap gap-4 lg:justify-end">
        <a href={SITE.phoneHref} class="btn btn-honey">Zadzwoń: {SITE.phoneDisplay}</a>
        <a href={`mailto:${SITE.email}`} class="btn btn-ghost">Napisz e-mail</a>
      </div>
    </div>
  </section>
</Base>
