---
import Base from '../layouts/Base.astro';
import { site, products } from '../data/site.js';
const tel = site.contact.phone.replace(/\s/g, '');
---

<Base
  title="Produkty"
  description="Bukiety i susz lawendowy, olejek eteryczny, hydrolat, mydła, saszetki, sadzonki i miód. Zamówienia telefonicznie lub mailem."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Produkty</p>
      <h1>Prosto z pola</h1>
      <p class="lede">
        Wszystko, co tu widzicie, powstaje z naszego zbioru. Nie prowadzimy sklepu
        internetowego — zamówienia przyjmujemy telefonicznie i mailem, a w sezonie
        po prostu kupujecie na miejscu.
      </p>
    </div>
  </section>

  <section class="wrap">
    <div class="grid grid--3">
      {
        products.map((p) => (
          <article class="card">
            {p.tag && <span class="tag">{p.tag}</span>}
            <h3>{p.name}</h3>
            <span class="card__price">{p.price}</span>
            <p>{p.desc}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid--2">
      <div>
        <p class="eyebrow">Jak zamówić</p>
        <h2>Trzy sposoby</h2>
        <ul class="ticks">
          <li><strong>Na miejscu</strong> — w sezonie sklepik jest otwarty w godzinach zwiedzania.</li>
          <li><strong>Telefonicznie</strong> — {site.contact.phoneDisplay}, odbieramy osobiście.</li>
          <li><strong>Mailem</strong> — {site.contact.email}, odpisujemy w ciągu doby.</li>
        </ul>
        <p class="hint">
          Wysyłamy paczkomatem i kurierem. Koszt wysyłki ustalamy przy zamówieniu,
          płatność przelewem lub przy odbiorze.
        </p>
      </div>
      <div>
        <p class="eyebrow">Na prezent</p>
        <h2>Zamówienia specjalne</h2>
        <p>
          Robimy większe zamówienia na wesela, chrzciny i upominki firmowe —
          bukieciki do stołów, saszetki dla gości, dekoracje z suszu.
          Przy takich rzeczach warto odezwać się z kilkutygodniowym wyprzedzeniem.
        </p>
        <p class="btns">
          <a class="btn" href={`tel:${tel}`}>Zadzwoń</a>
          <a class="btn btn--ghost" href={`mailto:${site.contact.email}`}>Napisz</a>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hint { font-size: 0.9rem; color: var(--ink-faint); margin-top: 1.5rem; }
  .btns { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.5rem; }
</style>
