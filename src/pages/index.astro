---
import Base from '../layouts/Base.astro';
import BloomStatus from '../components/BloomStatus.astro';
import Photo from '../components/Photo.astro';
import { site, visiting, products, events } from '../data/site.js';

const tel = site.contact.phone.replace(/\s/g, '');
---

<Base>
  <!-- ── HERO ─────────────────────────────────────────────── -->
  <section class="hero">
    <Photo ratio="16 / 9" label="Zdjęcie główne — pole w pełnym kwitnieniu" alt="Pole lawendy" />
    <div class="hero__panel">
      <div class="wrap">
        <p class="eyebrow">Hektar lawendy · {visiting.season}</p>
        <h1>Przyjedź, kiedy pachnie najmocniej</h1>
        <p class="lede">
          Prowadzimy rodzinne pole lawendy, które założyła moja mama. Latem otwieramy
          je dla gości — na spacer między rzędami, na zdjęcia i po bukiet, który
          zostanie z Wami na długo po sezonie.
        </p>
        <div class="hero__cta">
          <a class="btn" href="/zwiedzanie/">Zaplanuj wizytę</a>
          <a class="btn btn--ghost" href="/produkty/">Zobacz produkty</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── STATUS KWITNIENIA ────────────────────────────────── -->
  <section class="wrap status">
    <BloomStatus />
    <div class="status__hours">
      <p class="eyebrow">Godziny otwarcia</p>
      {visiting.hours.map((h) => <p class="status__row"><span>{h.days}</span><span>{h.time}</span></p>)}
    </div>
  </section>

  <!-- ── CO U NAS ─────────────────────────────────────────── -->
  <section class="section section--tint">
    <div class="wrap">
      <p class="eyebrow">Co możesz u nas robić</p>
      <h2>Cztery powody, żeby wpaść</h2>
      <div class="grid grid--2 offer">
        <a class="card offer__i" href="/zwiedzanie/">
          <h3>Spacer po polu</h3>
          <p>Wstęp od {visiting.tickets[0].price}. Ścieżki między rzędami, ławki, cień i cisza. Bez limitu czasu.</p>
        </a>
        <a class="card offer__i" href="/sesje/">
          <h3>Sesja zdjęciowa</h3>
          <p>Ślubna, rodzinna, ciążowa. Rezerwujemy pole na wyłączność, żeby w kadrze nie było nikogo obcego.</p>
        </a>
        <a class="card offer__i" href="/produkty/">
          <h3>Produkty z pola</h3>
          <p>Bukiety, susz, olejek, hydrolat, mydła i miód z pasieki stojącej tuż przy lawendzie.</p>
        </a>
        <a class="card offer__i" href="/wydarzenia/">
          <h3>Warsztaty</h3>
          <p>Wyplatanie wianków, destylacja olejku, Święto Lawendy w lipcu i wycieczki dla grup.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── HISTORIA ─────────────────────────────────────────── -->
  <section class="section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Nasza historia</p>
        <h2>Zaczęło się od jednej grządki mamy</h2>
        <p>
          Mama posadziła pierwsze krzaki dla zapachu w ogrodzie. Kilka lat później
          lawenda zajmowała już cały hektar, a my nauczyliśmy się ją przycinać,
          zbierać i destylować.
        </p>
        <p>
          Dziś prowadzę pole dalej — tak samo bez chemii i tak samo ręcznie.
          Każdy bukiet, który u nas kupujecie, ktoś z rodziny związał osobiście.
        </p>
        <a class="btn btn--ghost" href="/o-nas/">Poznaj nas bliżej</a>
      </div>
      <Photo label="Zdjęcie — mama / rodzina przy lawendzie" alt="Rodzina na polu lawendy" seed={1} />
    </div>
  </section>

  <!-- ── PRODUKTY ─────────────────────────────────────────── -->
  <section class="section section--tint">
    <div class="wrap">
      <p class="eyebrow">Sklepik na polu</p>
      <h2>Zabierz lawendę do domu</h2>
      <div class="grid grid--3">
        {
          products.slice(0, 4).map((p) => (
            <article class="card">
              {p.tag && <span class="tag">{p.tag}</span>}
              <h3>{p.name}</h3>
              <span class="card__price">{p.price}</span>
              <p>{p.desc}</p>
            </article>
          ))
        }
      </div>
      <p class="after">
        <a class="btn btn--ghost" href="/produkty/">Cała oferta</a>
      </p>
    </div>
  </section>

  <!-- ── WYDARZENIA ───────────────────────────────────────── -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">W sezonie</p>
      <h2>Warsztaty i wydarzenia</h2>
      <div class="rows">
        {
          events.map((e) => (
            <div>
              <span class="rows__k">{e.name}</span>
              <span class="rows__v">{e.price}</span>
              <span class="rows__note">{e.when} — {e.desc}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────── -->
  <section class="cta">
    <div class="wrap wrap--narrow">
      <h2>Chcesz przyjechać albo coś zamówić?</h2>
      <p class="lede">Zadzwoń lub napisz — odbieramy osobiście, także w niedzielę.</p>
      <p class="cta__btns">
        <a class="btn" href={`tel:${tel}`}>{site.contact.phoneDisplay}</a>
        <a class="btn btn--ghost" href={`mailto:${site.contact.email}`}>Napisz e-mail</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
  }
  .hero :global(.photo) {
    border-radius: 0;
    max-height: 70vh;
  }
  .hero__panel {
    background: var(--paper);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  .hero__panel .lede {
    max-width: 40rem;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .status {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    align-items: center;
    padding-bottom: var(--section);
  }
  .status__row {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
    max-width: 22rem;
    font-size: 0.95rem;
  }

  /* cztery kafelki mają leżeć 2×2, nie 3+1 */
  @media (min-width: 48rem) {
    .offer {
      grid-template-columns: 1fr 1fr;
    }
  }
  .offer__i {
    text-decoration: none;
    color: inherit;
    transition: border-color 0.18s ease, background 0.18s ease;
  }
  .offer__i:hover {
    border-color: var(--lavender);
    background: color-mix(in srgb, var(--lavender-pale) 35%, var(--paper));
  }

  .split {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    align-items: center;
  }

  .after {
    margin-top: 2.5rem;
  }

  .cta {
    text-align: center;
    padding-block: var(--section);
    background: var(--lavender-deep);
    color: var(--paper);
  }
  .cta h2,
  .cta .lede {
    color: var(--paper);
  }
  .cta p {
    margin-inline: auto;
  }
  .cta .lede {
    opacity: 0.82;
  }
  .cta__btns {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .cta .btn {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--lavender-deep);
  }
  .cta .btn:hover {
    background: var(--lavender-pale);
    border-color: var(--lavender-pale);
    color: var(--lavender-deep);
  }
  .cta .btn--ghost {
    background: transparent;
    color: var(--paper);
  }
  .cta .btn--ghost:hover {
    background: var(--paper);
    color: var(--lavender-deep);
  }
</style>
