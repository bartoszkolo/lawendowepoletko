---
import Base from '../layouts/Base.astro';
import BloomStatus from '../components/BloomStatus.astro';
import Socials from '../components/Socials.astro';
import { site, visiting } from '../data/site.js';

const tel = site.contact.phone.replace(/\s/g, '');

// Mapa i nawigacja jadą po nazwie i adresie, nie po współrzędnych —
// dzięki temu trafiają dokładnie w wizytówkę Google, którą prowadzicie.
const query = encodeURIComponent(
  `${site.name}, ${site.address.street}, ${site.address.postalCode} ${site.address.city}`
);
const mapEmbed = `https://maps.google.com/maps?q=${query}&z=13&hl=pl&output=embed`;
const mapLink = `https://www.google.com/maps/dir/?api=1&destination=${query}`;
---

<Base
  title="Kontakt i dojazd"
  description="Adres pola lawendy, mapa dojazdu, telefon i e-mail. Parking bezpłatny przy wjeździe."
>
  <section class="section">
    <div class="wrap grid grid--2">
      <div>
        <p class="eyebrow">Kontakt</p>
        <h1>Odezwij się</h1>
        <p class="lede">
          Najszybciej telefonicznie — odbieramy osobiście, także w weekendy.
          W środku pola bywa słaby zasięg, więc jeśli nie odbierzemy, oddzwonimy.
        </p>

        <div class="rows contact">
          <div><span class="rows__k">Telefon</span><a href={`tel:${tel}`}>{site.contact.phoneDisplay}</a></div>
          <div><span class="rows__k">E-mail</span><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></div>
          <div>
            <span class="rows__k">Adres</span>
            <span>{site.address.street}, {site.address.postalCode} {site.address.city}</span>
          </div>
        </div>

        <p class="btns">
          <a class="btn" href={mapLink} target="_blank" rel="noopener">Wyznacz trasę</a>
        </p>

        <div class="soc-block">
          <p class="eyebrow">Znajdziesz nas też tutaj</p>
          <p class="soc-note">
            Aktualne zdjęcia z pola wrzucamy na bieżąco w sezonie — tam najszybciej
            zobaczysz, jak w danym tygodniu wygląda lawenda.
          </p>
          <Socials variant="list" />
        </div>
      </div>

      <div>
        <BloomStatus />
        <div class="hours">
          <p class="eyebrow">Otwarte w sezonie ({visiting.season})</p>
          {visiting.hours.map((h) => (
            <p class="hours__row"><span>{h.days}</span><span>{h.time}</span></p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="wrap">
    <iframe
      class="map"
      src={mapEmbed}
      title="Mapa dojazdu do Lawendowego Poletka"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </section>

  <section class="section">
    <div class="wrap grid grid--2">
      <div>
        <p class="eyebrow">Dojazd</p>
        <h2>Jak trafić</h2>
        <ul class="ticks">
          <li>Nawigację ustaw na adres powyżej — dowiezie pod samo pole.</li>
          <li>Ostatni odcinek to droga gruntowa; przy suchej pogodzie przejedzie każde auto.</li>
          <li>Od głównej drogi ustawiamy w sezonie tabliczki z lawendą.</li>
          <li>{visiting.parking}</li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Udogodnienia</p>
        <h2>Na miejscu</h2>
        <ul class="ticks">
          <li>Toaleta i miejsce do przewijania.</li>
          <li>Zadaszona wiata z ławkami i wodą.</li>
          <li>Sklepik z produktami z pola.</li>
          <li>Ścieżki są w miarę równe, ale to pole — wózek trzeba czasem podnieść.</li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact { margin-top: 2rem; }
  .contact a { font-family: var(--display); font-size: 1.15rem; }
  .btns { margin-top: 2rem; }
  .soc-block {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .soc-note {
    font-size: 0.95rem;
    color: var(--ink-soft);
    margin-bottom: 1.25rem;
  }
  .hours { margin-top: 2rem; }
  .hours__row {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
    max-width: 24rem;
    font-size: 0.95rem;
  }
  .map {
    width: 100%;
    aspect-ratio: 21 / 9;
    min-height: 20rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
</style>
