---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const categories = [...new Set(articles.map((a) => a.data.category))];

const fmt = (d: Date) =>
  d.toLocaleDateString("pl-PL", { day: "numeric", month: "long", year: "numeric" });
---

<Base
  title="Lawendowy poradnik — uprawa, pielęgnacja i produkty z lawendy | Lawendowe Poletko"
  description="Praktyczna wiedza z pole lawendy: kiedy kwitnie i jak przycinać lawendę, sadzenie, podlewanie, uprawa w donicy, suszenie oraz olejek i hydrolat."
  path="/poradnik"
>
  <PageHero
    eyebrow="Wiedza prosto z pola"
    lead="Wszystko, co wiemy o lawendzie — sprawdzone na własnej uprawie. Poradniki dla ogrodników, fotografów i fanów zapachu lata."
  >
    Lawendowy <em class="text-lav-200">poradnik.</em>
  </PageHero>

  <section class="wrap py-16 sm:py-24">
    <div class="flex flex-wrap gap-2.5" data-reveal>
      {categories.map((c) => <span class="chip bg-lav-100 text-lav-700">{c}</span>)}
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        articles.map((article, i) => (
          <a
            href={`/poradnik/${article.id}`}
            class="card group flex flex-col p-7 transition-transform duration-300 hover:-translate-y-1.5"
            data-reveal
            data-reveal-delay={String((i % 3) + 1)}
          >
            <div class="flex items-center justify-between gap-3">
              <span class="chip self-start bg-lav-100 text-lav-700">{article.data.category}</span>
              <time datetime={article.data.pubDate.toISOString()} class="text-xs font-bold uppercase tracking-[0.12em] text-lav-400">
                {fmt(article.data.pubDate)}
              </time>
            </div>
            <h2 class="mt-4 font-display text-xl leading-snug transition-colors group-hover:text-lav-600">
              {article.data.title}
            </h2>
            <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-inksoft">{article.data.description}</p>
            <span class="mt-auto pt-5 text-xs font-bold uppercase tracking-[0.14em] text-lav-400">
              Czytaj · {article.data.readTime}
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
